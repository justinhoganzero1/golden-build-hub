{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://tpkpfkcnqdyrzpqdoqnp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "oracle-lunar-mcp",
      "version": "0.2.0",
      "title": "Oracle Lunar"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in Oracle Lunar user (id and email) for the current MCP session.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_diary_entries",
        "title": "List diary entries",
        "description": "List the signed-in user's Life Diary entries, most recent first. RLS restricts results to this user only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of entries to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_diary_entry",
        "title": "Create diary entry",
        "description": "Create a new Life Diary entry for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Short title for the entry."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "description": "Body text of the diary entry."
            },
            "mood": {
              "type": "string",
              "description": "Optional mood label, e.g. 'calm', 'grateful'."
            },
            "entry_date": {
              "type": "string",
              "description": "YYYY-MM-DD date. Defaults to today."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "category": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_wallet_balance",
        "title": "Get wallet balance",
        "description": "Return the signed-in user's Oracle Lunar wallet balance (cents) and currency.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_calendar_events",
        "title": "List calendar events",
        "description": "List the signed-in user's upcoming calendar events, sorted by date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "description": "Inclusive YYYY-MM-DD start date. Defaults to today."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_books",
        "title": "List my books",
        "description": "List the signed-in user's Story Writer books with id, title, chapter count and word count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_book_chapters",
        "title": "Read book chapters",
        "description": "Read the full text of a range of chapters (1-based, up to 5 at a time) from one of the user's books.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "book_id": {
              "type": "string",
              "format": "uuid",
              "description": "Book id from list_books."
            },
            "from_chapter": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "First chapter number."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 3,
              "description": "How many chapters to return (max 5)."
            }
          },
          "required": [
            "book_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "save_book_chapter",
        "title": "Save a book chapter",
        "description": "Replace an existing chapter's title and text, or add a new chapter at the end (chapter_number = total + 1). Existing pictures on that chapter are kept.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "book_id": {
              "type": "string",
              "format": "uuid",
              "description": "Book id from list_books."
            },
            "chapter_number": {
              "type": "integer",
              "minimum": 1,
              "description": "Chapter to replace, or total+1 to add a new one."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Chapter title."
            },
            "content": {
              "type": "string",
              "minLength": 50,
              "description": "Full chapter text."
            }
          },
          "required": [
            "book_id",
            "chapter_number",
            "title",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
